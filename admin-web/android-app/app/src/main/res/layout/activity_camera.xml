<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F5FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 홈으로 이동 -->
        <Button
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="홈"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5B6CFF"
            android:layout_gravity="end" />

        <!-- 제목 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="외상 사진 분석"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="20dp"
            android:layout_gravity="center_horizontal" />

        <!-- 설명 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="상처 사진을 선택하거나 직접 촬영해주세요."
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_horizontal" />

        <!-- 사진 미리보기 -->
        <ImageView
            android:id="@+id/imagePreview"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="30dp"
            android:background="#FFFFFF"
            android:scaleType="centerCrop"
            android:contentDescription="선택한 사진 미리보기" />

        <!-- 갤러리에서 선택 -->
        <Button
            android:id="@+id/btnUpload"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:text="갤러리에서 사진 선택"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#5B6CFF" />

        <!-- 사진 촬영 -->
        <Button
            android:id="@+id/btnCapture"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="15dp"
            android:text="사진 촬영"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#5B6CFF" />

        <!-- 분석하기 -->
        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:text="분석하기"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#3F51F5" />

    </LinearLayout>

</ScrollView>