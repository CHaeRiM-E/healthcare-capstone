<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="15dp"
    android:background="#FFFFFF"
    android:orientation="horizontal"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtHospitalName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="병원 이름"
            android:textColor="#111111"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHospitalDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="거리 350m"
            android:textColor="#5F86F2"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHospitalCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="정형외과"
            android:textColor="#555555"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtHospitalAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="서울특별시 성동구"
            android:textColor="#777777"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnRoute"
            android:layout_width="88dp"
            android:layout_height="48dp"
            android:backgroundTint="#5F86F2"
            android:text="길찾기"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCall"
            android:layout_width="88dp"
            android:layout_height="48dp"
            android:layout_marginTop="5dp"
            android:backgroundTint="#5F86F2"
            android:text="전화"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>