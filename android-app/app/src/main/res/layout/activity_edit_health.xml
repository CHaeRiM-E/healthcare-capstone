<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FD"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="26dp"
        android:paddingEnd="20dp"
        android:paddingBottom="45dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHome"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:backgroundTint="#EAF2FF"
                android:text="←"
                android:textAllCaps="false"
                android:textColor="#3A86FF"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/titleEditHealth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="건강 정보 수정"
                android:textColor="#202C43"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="50dp"
                android:layout_height="50dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_edit_health_header"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="나의 건강 프로필"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="알레르기, 지병, 복용약 정보를 최신 상태로 관리하세요."
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/editBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_edit_health_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="등록된 건강정보"
                android:textColor="#202C43"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="9dp"
                android:paddingBottom="13dp">

                <TextView
                    android:id="@+id/txtEditAllergy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="5dp"
                    android:text="알레르기 등록된 정보 없음"
                    android:textColor="#202C43"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnAddAllergy"
                    android:layout_width="52dp"
                    android:layout_height="50dp"
                    android:backgroundTint="#EAF2FF"
                    android:text="+"
                    android:textAllCaps="false"
                    android:textColor="#3A86FF"
                    android:textSize="24sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E8EDF5" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="13dp"
                android:paddingBottom="13dp">

                <TextView
                    android:id="@+id/txtEditDisease"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="5dp"
                    android:text="지병 등록된 정보 없음"
                    android:textColor="#202C43"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnAddDisease"
                    android:layout_width="52dp"
                    android:layout_height="50dp"
                    android:backgroundTint="#EAF2FF"
                    android:text="+"
                    android:textAllCaps="false"
                    android:textColor="#3A86FF"
                    android:textSize="24sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E8EDF5" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="13dp"
                android:paddingBottom="9dp">

                <TextView
                    android:id="@+id/txtEditMedicine"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="5dp"
                    android:text="복용 중인 약물 등록된 정보 없음"
                    android:textColor="#202C43"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnAddMedicine"
                    android:layout_width="52dp"
                    android:layout_height="50dp"
                    android:backgroundTint="#EAF2FF"
                    android:text="+"
                    android:textAllCaps="false"
                    android:textColor="#3A86FF"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/keywordPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_edit_health_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtKeywordTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="항목 선택"
                android:textColor="#202C43"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="검색 후 선택하거나 직접 추가할 수 있어요."
                android:textColor="#78869C"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/searchKeyword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_edit_health_input"
                android:hint="검색하거나 직접 입력해주세요."
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#202C43"
                android:textColorHint="#97A3B5"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnAddCustomKeyword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#4DADBD"
                android:text="입력한 내용 직접 추가"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSelectionGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="선택된 항목을 다시 누르면 삭제됩니다."
                android:textColor="#78869C"
                android:textSize="12sp" />

            <GridLayout
                android:id="@+id/keywordGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnClearSelection"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="#EAF2FF"
                    android:text="전체 삭제"
                    android:textAllCaps="false"
                    android:textColor="#3A86FF" />

                <Button
                    android:id="@+id/btnCloseKeyword"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="#202C43"
                    android:text="선택 닫기"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveHealth"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#3A86FF"
            android:text="수정 완료"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>