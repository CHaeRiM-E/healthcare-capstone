<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FD"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="MY HEALTH CARE"
                android:textColor="#3A86FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"
                android:text="오늘도 건강한 하루 ♥"
                android:textColor="#202C43"
                android:textSize="25sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/dashboardMedicine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💊 오늘의 복약"
                    android:textColor="#202C43"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dashboardMedicineSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="복약 정보 확인 중"
                    android:textColor="#3A86FF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/dashboardProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="1"
                    android:progress="0"
                    android:progressBackgroundTint="#EAF4FF"
                    android:progressTint="#3A86FF" />

                <TextView
                    android:id="@+id/dashboardMedicineDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="잠시만 기다려 주세요"
                    android:textColor="#718096"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/dashboardVisit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="110dp"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📅 다음 진료 예약"
                        android:textColor="#202C43"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dashboardVisitText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="예약 확인 중"
                        android:textColor="#718096"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dashboardAlerts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="110dp"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔔 복약 알림"
                        android:textColor="#202C43"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dashboardAlertsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="알림 확인 중"
                        android:textColor="#718096"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnInternalChat"
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_home_ai"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="22dp"
                android:text="💬 AI 건강상담\n\n증상이 걱정될 때 편하게 상담해 보세요 →"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="나의 건강관리"
                android:textColor="#202C43"
                android:textSize="20sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <Button
                    android:id="@+id/btnMedicine"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_columnWeight="1"
                    android:backgroundTint="#FFFFFF"
                    android:elevation="2dp"
                    android:text="💊\n복용약 관리"
                    android:textAllCaps="false"
                    android:textColor="#172554"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCameraResult"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_columnWeight="1"
                    android:backgroundTint="#FFFFFF"
                    android:elevation="2dp"
                    android:text="📷\n상처 사진 분석"
                    android:textAllCaps="false"
                    android:textColor="#172554"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnInternalRecord"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_columnWeight="1"
                    android:backgroundTint="#FFFFFF"
                    android:elevation="2dp"
                    android:text="📋\n내상 상담 기록"
                    android:textAllCaps="false"
                    android:textColor="#172554"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnInjuryRecord"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_columnWeight="1"
                    android:backgroundTint="#FFFFFF"
                    android:elevation="2dp"
                    android:text="🩹\n외상 분석 기록"
                    android:textAllCaps="false"
                    android:textColor="#172554"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </GridLayout>

            <Button
                android:id="@+id/btnHospital"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#087F72"
                android:elevation="2dp"
                android:text="🏥 가까운 병원 찾기 →"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="12dp"
                android:text="건강정보"
                android:textColor="#172554"
                android:textSize="20sp"
                android:textStyle="bold" />


            <Button
                android:id="@+id/btnCardNews"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:backgroundTint="#FFFFFF"
                android:elevation="2dp"
                android:text="📖 건강정보 보기 →"
                android:textAllCaps="false"
                android:textColor="#172554"
                android:textSize="15sp"
                android:textStyle="bold" />


            <Button
                android:id="@+id/btnHealthBenefits"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#DFF6EF"
                android:elevation="2dp"
                android:text="🎁 건강검진 제도 및 혜택 →"
                android:textAllCaps="false"
                android:textColor="#075E54"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#E5EDFF"
            android:text="⌂\n홈"
            android:textAllCaps="false"
            android:textColor="#2449C5"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/navAi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:text="💬\nAI 상담"
            android:textAllCaps="false"
            android:textColor="#475569"
            android:textSize="12sp" />

        <Button
            android:id="@+id/navSchedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:text="📅\n일정"
            android:textAllCaps="false"
            android:textColor="#475569"
            android:textSize="12sp" />

        <Button
            android:id="@+id/navNews"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:text="📖\n건강소식"
            android:textAllCaps="false"
            android:textColor="#475569"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnMyInfo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:text="👤\n내 정보"
            android:textAllCaps="false"
            android:textColor="#475569"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>