<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FF"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="35dp"
    android:paddingEnd="20dp">

    <!-- 상단 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnHome"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:backgroundTint="#5F86F2"
            android:text="⌂"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="가까운 병원 찾기"
            android:textColor="#111111"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="75dp"
            android:layout_height="58dp"
            android:backgroundTint="#5F86F2"
            android:text="뒤로"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- 현재 위치 -->
    <TextView
        android:id="@+id/txtLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="📍 현재 위치를 확인하고 있습니다."
        android:textColor="#5F86F2"
        android:textSize="19sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnRefreshLocation"
        android:layout_width="170dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:backgroundTint="#5F86F2"
        android:text="현재 위치 다시 찾기"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- 진행 표시 -->
    <ProgressBar
        android:id="@+id/progressHospital"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:indeterminateTint="#5F86F2"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtHospitalCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="주변 병원"
        android:textColor="#111111"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtEmptyHospital"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:gravity="center"
        android:text="주변 병원을 찾을 수 없습니다."
        android:textColor="#777777"
        android:textSize="16sp"
        android:visibility="gone" />
    <!-- 카카오 지도 영역 -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="12dp"
        android:background="#E8EEFF" />
    <!-- 지도 마커 클릭 시 표시되는 병원 정보 카드 -->
    <LinearLayout
        android:id="@+id/hospitalInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtSelectedHospitalName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="병원 이름"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseHospitalCard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#777777"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtSelectedHospitalAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="병원 주소"
            android:textColor="#666666"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtSelectedHospitalCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="진료과목"
            android:textColor="#5F86F2"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSelectedHospitalCall"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:backgroundTint="#5F86F2"
                android:text="전화"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnSelectedHospitalRoute"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#5F86F2"
                android:text="길찾기"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
    <!-- 실제 병원 목록 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerHospitals"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="15dp" />

    <Button
        android:id="@+id/btnOpenMap"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="25dp"
        android:backgroundTint="#FFFFFF"
        android:text="지도에서 주변 병원 보기"
        android:textColor="#333333"
        android:textSize="17sp"
        android:textStyle="bold" />

</LinearLayout>