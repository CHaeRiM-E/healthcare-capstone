<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FD"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="42dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHome"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:backgroundTint="#EDF5FF"
                android:text="←"
                android:textAllCaps="false"
                android:textColor="#3A86FF"
                android:textSize="21sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="내 정보"
                android:textColor="#202C43"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_myinfo_hero"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="♡ MY HEALTH"
                android:textColor="#EAF3FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="나의 건강 프로필"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="건강 정보를 한곳에서 확인하고 관리해요"
                android:textColor="#F0F6FF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/healthBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_myinfo_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="건강 정보"
                android:textColor="#202C43"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="등록된 정보를 확인하고 수정할 수 있어요"
                android:textColor="#7B879F"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtAllergy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:background="@drawable/bg_myinfo_soft"
                android:padding="14dp"
                android:text="알레르기 : 등록된 정보 없음"
                android:textColor="#202C43"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtDisease"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_myinfo_soft"
                android:padding="14dp"
                android:text="지병 : 등록된 정보 없음"
                android:textColor="#202C43"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtMedicine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_myinfo_soft"
                android:padding="14dp"
                android:text="복용 중인 약물 : 등록된 정보 없음"
                android:textColor="#202C43"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnEditHealth"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#3A86FF"
                android:text="건강 정보 수정하기"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/contactBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_myinfo_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="긴급 보호자"
                    android:textColor="#202C43"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnChangeGuardian"
                    android:layout_width="84dp"
                    android:layout_height="44dp"
                    android:backgroundTint="#E8F6F8"
                    android:text="변경"
                    android:textAllCaps="false"
                    android:textColor="#217C8B"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtGuardian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="등록된 보호자가 없습니다."
                android:textColor="#202C43"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtEmergencyContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_myinfo_soft"
                android:padding="12dp"
                android:text="긴급 상황 연락 사용 안 함"
                android:textColor="#58718F"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_myinfo_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="계정 정보"
                android:textColor="#202C43"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLoginInfo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#EDF5FF"
                android:text="로그인 이메일 확인 ›"
                android:textAllCaps="false"
                android:textColor="#3A68A8"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>